{
  "name": "n8n-nodes-zatca-tools",
  "version": "1.0.2",
  "description": "Issue Saudi ZATCA Phase 2 e-invoices (signed, QR, reported) from any n8n workflow.",
  "keywords": [
    "n8n-community-node-package",
    "zatca",
    "e-invoice",
    "saudi arabia",
    "vat",
    "fatoora"
  ],
  "license": "MIT",
  "homepage": "https://zatcatools.com/docs/api",
  "author": {
    "name": "ZATCA Tools",
    "email": "support@zatcatools.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/muhannadhg/n8n-nodes-zatca-tools.git"
  },
  "engines": {
    "node": ">=20.15"
  },
  "main": "index.js",
  "scripts": {
    "build": "npx rimraf dist && tsc && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "eslint nodes credentials package.json",
    "lintfix": "eslint nodes credentials package.json --fix"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/ZatcaToolsApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/ZatcaTools/ZatcaTools.node.js",
      "dist/nodes/ZatcaTools/ZatcaToolsTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.32.0",
    "eslint": "^8.57.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.3",
    "gulp": "^5.0.0",
    "n8n-workflow": "*",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
